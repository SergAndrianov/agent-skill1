workspace "ПлатиДом — автоплатёж с лимитом суммы" "C4 L2 для SCRUM-2166" {
    !impliedRelationships false

    model {
        client = person "Клиент" "Пользователь мобильного банка. Управляет своими автоплатежами и смотрит их результаты."
        accrualSource = softwareSystem "ГИС ЖКХ" "Источник начислений по поставщику и лицевому счёту (A-01)." "External"
        processing = softwareSystem "Процессинг карт" "Принимает оплату и предоставляет результат операции в учебной модели (A-12)." "External"
        platidom = softwareSystem "ПлатиДом" "Раздел мобильного банка для регулярных начислений семьи." {
            mobile = container "Мобильное приложение банка" "Показывает свои привязки, настройки и историю. Принимает согласие и команды управления автоплатежом." "iOS / Android" "Mobile"
            api = container "API ПлатиДома" "Проверяет сессию и права. Сохраняет настройки, координирует отключение и выдаёт историю владельца." "Java / Spring Boot"
            worker = container "Фоновый обработчик автоплатежей" "Планирует и захватывает задания. Проверяет допуск к оплате, отправляет платёж и сверяет результат." "Java / Spring Boot"
            db = container "База данных ПлатиДома" "Хранит привязки, результаты обновления начислений, правила, задания, попытки и причины пропуска." "PostgreSQL" "Database"
        }

        client -> mobile "Выбирает свою сохранённую привязку, смотрит правила и результаты" "Интерфейс приложения"
        client -> mobile "Подтверждает настройку или отключает правило" "Интерфейс приложения" "Write"
        mobile -> api "Запрашивает свои привязки, правила и историю" "HTTPS/JSON"
        mobile -> api "Включает или меняет правило по ID привязки, источнику оплаты, лимиту и согласию. Отключает правило по ID" "HTTPS/JSON" "Write"
        api -> db "Читает привязки, правила и историю владельца" "SQL/JDBC"
        api -> db "Сохраняет настройки и согласие. Координирует отключение правила" "SQL/JDBC" "Write"
        api -> processing "Проверяет доступность источника оплаты клиенту, если эту проверку выполняет процессинг" "Владелец и контракт открыты (Q-06)" "Conditional"
        worker -> db "Читает привязки, версии правил, готовые задания и попытки для сверки" "SQL/JDBC"
        worker -> db "Планирует и захватывает задания. Фиксирует допуск, ключ операции и исход либо причину пропуска" "SQL/JDBC" "Write"
        worker -> accrualSource "Запрашивает начисления по поставщику и лицевому счёту для проверки актуальности и состояния" "Контракт открыт (A-14, Q-02)"
        worker -> processing "Проверяет источник оплаты и достаточность средств для суммы, если эту проверку выполняет процессинг" "Владелец и контракт открыты (Q-06)" "Conditional"
        worker -> processing "Передаёт ID начисления, источник оплаты, полную сумму, валюту и ключ операции ПлатиДома" "Контракт открыт (A-09, A-12)" "Write"
        worker -> processing "До внешнего ID читает статус по ключу, сохранённому до отправки, если это поддерживается. Затем читает по внешнему ID" "Контракт открыт (A-09, Q-03)"
    }

    views {
        container platidom "AutopayLimit" "Настройка, исполнение и сверка автоплатежа с лимитом" {
            include *
            title "ПлатиДом — автоплатёж с лимитом суммы (C4 L2)"
            autoLayout tb 450 340
        }

        styles {
            element "Element" {
                width 440
                height 200
                color #ffffff
                fontSize 22
            }
            element "Person" {
                shape Person
                background #164e63
            }
            element "Container" {
                background #1e40af
            }
            element "Mobile" {
                shape MobileDevicePortrait
            }
            element "Database" {
                shape Cylinder
            }
            element "External" {
                background #475569
            }
            relationship "Relationship" {
                style solid
                color #475569
                fontSize 20
                width 240
            }
            relationship "Write" {
                color #1e40af
            }
            relationship "Conditional" {
                style dashed
            }
        }
    }
}
